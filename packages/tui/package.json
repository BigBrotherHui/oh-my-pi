{
  "type": "module",
  "name": "@oh-my-pi/pi-tui",
  "version": "18.2.6",
  "description": "Terminal User Interface library with differential rendering for efficient text-based applications",
  "homepage": "https://omp.sh",
  "author": "Stencil Labs, Inc.",
  "contributors": [
    "Mario Zechner"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/can1357/oh-my-pi.git",
    "directory": "packages/tui"
  },
  "bugs": {
    "url": "https://github.com/can1357/oh-my-pi/issues"
  },
  "keywords": [
    "tui",
    "terminal",
    "ui",
    "text-editor",
    "differential-rendering",
    "typescript",
    "cli"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "check": "oxlint . && oxfmt --check --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts' && bun run check:types",
    "check:types": "tsgo -p tsconfig.json --noEmit",
    "check:arch": "bun scripts/check-architecture.ts",
    "lint": "oxlint .",
    "test": "bun test --parallel test",
    "fix": "oxlint --fix --fix-suggestions . && bun run fmt",
    "fmt": "oxfmt --no-error-on-unmatched-pattern 'src/**/*.{ts,tsx}' '{test,bench,examples,scripts}/**/*.ts' '*.ts'"
  },
  "dependencies": {
    "@oh-my-pi/omptype": "catalog:",
    "@oh-my-pi/pi-agent-core": "catalog:",
    "@oh-my-pi/pi-ai": "catalog:",
    "@oh-my-pi/pi-catalog": "catalog:",
    "@oh-my-pi/pi-natives": "catalog:",
    "@oh-my-pi/pi-utils": "catalog:",
    "@oh-my-pi/pi-wire": "catalog:",
    "@oh-my-pi/snapcompact": "catalog:",
    "@babel/core": "catalog:",
    "@babel/plugin-transform-typescript": "catalog:",
    "babel-plugin-jsx-dom-expressions": "catalog:",
    "solid-js": "catalog:"
  },
  "devDependencies": {
    "@types/babel__core": "catalog:",
    "kitty-vt-wasm": "catalog:"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./jsx-runtime": {
      "types": "./src/jsx-runtime.ts",
      "import": "./src/jsx-runtime.ts"
    },
    "./overlay": {
      "types": "./src/host/overlay.ts",
      "import": "./src/host/overlay.ts"
    },
    "./reactive": {
      "types": "./src/reactive/index.ts",
      "import": "./src/reactive/index.ts"
    },
    "./root": {
      "types": "./src/root.ts",
      "import": "./src/root.ts"
    },
    "./view": {
      "types": "./src/view/index.ts",
      "import": "./src/view/index.ts"
    },
    "./view/*": {
      "types": ["./src/view/*.ts", "./src/view/*.tsx"],
      "import": "./src/view/*"
    },
    "./document": {
      "types": "./src/document/index.ts",
      "import": "./src/document/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "import": "./src/theme/index.ts"
    },
    "./theme/defaults": {
      "types": "./src/theme/defaults/index.ts",
      "import": "./src/theme/defaults/index.ts"
    },
    "./theme/*": {
      "types": ["./src/theme/*.ts", "./src/theme/*.tsx"],
      "import": "./src/theme/*"
    },
    "./tools": {
      "types": "./src/tools/index.ts",
      "import": "./src/tools/index.ts"
    },
    "./status-line": {
      "types": "./src/status-line/index.ts",
      "import": "./src/status-line/index.ts"
    },
    "./*": {
      "types": ["./src/*.ts", "./src/*.tsx"],
      "import": "./src/*"
    },
    "./*.js": {
      "types": ["./src/*.ts", "./src/*.tsx"],
      "default": "./src/*"
    }
  }
}
